# 复制为 .env 后按需修改（勿把密码提交进仓库）
API_HOST=0.0.0.0
API_PORT=18766
FRONTEND_PORT=19081
SERVE_FRONTEND=0
# 本地开启表更新 API（公网暴露时请保持 0）
UPDATE_API_ENABLED=1
VITE_PREVIEW_ALLOWED_HOSTS=your-tunnel-2.vip.cpolar.cn,.vip.cpolar.cn,.cpolar.cn

# 云端推送（deploy/推送增量.sh）需要时再 export，不要写进本文件提交
# SSHPASS=

# 数据库 DSN 默认本地 peer：见 后端/配置/数据库.yaml
