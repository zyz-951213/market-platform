[Unit]
Description=Database Manager API (FastAPI, readonly)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/zhuyizhou/my_projects/market-platform/packages/data
EnvironmentFile=-/home/zhuyizhou/my_projects/market-platform/packages/data/.env
Environment=PYTHONUNBUFFERED=1
Environment=SERVE_FRONTEND=0
ExecStart=/home/zhuyizhou/miniconda3/bin/python -m uvicorn 后端.接口.应用:app --host 0.0.0.0 --port 18766
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/zhuyizhou/my_projects/market-platform/packages/data/logs/api.log
StandardError=append:/home/zhuyizhou/my_projects/market-platform/packages/data/logs/api.log

[Install]
WantedBy=default.target
