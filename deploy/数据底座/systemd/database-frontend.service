[Unit]
Description=Database Manager Frontend (Vite Preview)
After=network-online.target database-api.service
Wants=network-online.target database-api.service

[Service]
Type=simple
WorkingDirectory=/home/zhuyizhou/my_projects/market-platform/packages/data/前端
EnvironmentFile=-/home/zhuyizhou/my_projects/market-platform/packages/data/.env
Environment=NODE_ENV=production
Environment=API_PORT=18766
Environment=FRONTEND_PORT=19081
Environment=VITE_PREVIEW_ALLOWED_HOSTS=your-tunnel-2.vip.cpolar.cn,.vip.cpolar.cn,.cpolar.cn
ExecStartPre=/usr/bin/bash -c 'test -f dist/index.html || /home/zhuyizhou/.local/bin/npm run build'
ExecStart=/home/zhuyizhou/.local/bin/npm run preview -- --host 0.0.0.0 --port 19081
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/zhuyizhou/my_projects/market-platform/packages/data/logs/frontend.log
StandardError=append:/home/zhuyizhou/my_projects/market-platform/packages/data/logs/frontend.log

[Install]
WantedBy=default.target
