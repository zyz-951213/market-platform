[Unit]
Description=指数预测 每日增量更新(one-shot)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@仓库根@
EnvironmentFile=-@仓库根@/config/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@PYTHON@ -m market_platform.cli predictor update --once
StandardOutput=append:@仓库根@/日志/指数预测-更新.log
StandardError=append:@仓库根@/日志/指数预测-更新.log
