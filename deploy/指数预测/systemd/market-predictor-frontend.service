[Unit]
Description=Market Predictor Frontend (Vite Preview)
After=network-online.target market-predictor-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@/前端
Environment=NODE_ENV=production
ExecStart=@NPM_BIN@ run preview -- --host 0.0.0.0 --port 19080
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
