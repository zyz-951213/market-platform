# Market Predictor 环境变量
# 复制: cp .env.example .env

# DeepSeek API（deepseek-v4-pro）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Tuzi API（claude / gemini / grok 等走兔子的渠道）
TUZI_API_KEY=sk-your-tuzi-key-here

# Kimi / Moonshot 官方（kimi-k3）— https://platform.kimi.ai
MOONSHOT_API_KEY=sk-your-moonshot-key-here

# MiniMax 官方（MiniMax-M3）— https://platform.minimax.io / 国内 minimaxi
MINIMAX_API_KEY=your-minimax-key-here

# 阿里云百炼 DashScope（通义 qwen3-max）— https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=sk-your-dashscope-key-here

# 火山方舟（豆包 doubao-seed-2-0-pro-260215）— https://console.volcengine.com/ark
# 也可用推理接入点 ep-xxx（在本地.yaml 覆盖 model）
ARK_API_KEY=your-ark-api-key-here

# GLM-4.7 现默认走阿里百炼（DASHSCOPE_API_KEY）；智谱直连可选
# ZHIPU_API_KEY=your-zhipu-api-key-here

# 可选：自定义配置文件路径（默认 后端/配置/配置档/默认.yaml）
# CONFIG_PATH=后端/配置/配置档/默认.yaml

# 可选：Tushare token（沪深300 备选数据源）
# TUSHARE_TOKEN=

# 可选：日志级别 DEBUG | INFO | WARNING
# LOG_LEVEL=INFO

# Web 端口（与 market-agents 8080/8766 错开）
FRONTEND_PORT=19080
API_PORT=18765

# cpolar 等公网隧道：Vite preview 允许的 Host（逗号分隔，.vip.cpolar.cn 匹配所有二级域名）
# VITE_PREVIEW_ALLOWED_HOSTS=your-tunnel-1.vip.cpolar.cn,.vip.cpolar.cn
