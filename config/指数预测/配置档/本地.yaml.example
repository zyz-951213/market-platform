# 本地密钥覆盖（此文件已在 .gitignore，不会提交）
# 复制为 本地.yaml 并填入 Key，或在 .env 中设置环境变量

model:
  llm:
    providers:
      deepseek:
        api_key: "your-deepseek-key"
      tuzi_sonnet:
        api_key: "your-tuzi-key"
      tuzi_gpt:
        api_key: "your-tuzi-key"
      tuzi_gemini:
        api_key: "your-tuzi-key"
      tuzi_grok:
        api_key: "your-tuzi-key"
      minimax:
        api_key: "your-minimax-key"
      qwen:
        api_key: "your-dashscope-key"
      doubao:
        api_key: "your-ark-api-key"
        # 若使用接入点，取消下一行并改成你的 ep-xxx：
        # model: "ep-xxxxxxxx"
