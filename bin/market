#!/usr/bin/env bash
# market — 统一入口(薄封装:全部委托 market_platform.cli)
#
#   market web                    统一站点 + 三域 API(门户)
#   market data   <命令>          数据底座
#   market agents <命令>          行为分析
#   market predictor <命令>       指数预测
#   market 健康                    配置与库连通性
#
# 历史版本把 `data <脚本>` 指向 packages/data/后端/脚本/(该目录已不存在),
# 现统一走 Python 包入口,不再依赖工作目录与相对脚本路径。
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

PY="${MARKET_PYTHON:-}"
if [[ -z "$PY" ]]; then
  if command -v python3 >/dev/null 2>&1 && python3 -c "import market_platform" >/dev/null 2>&1; then
    PY="python3"
  elif [[ -x "$HOME/miniconda3/bin/python" ]]; then
    PY="$HOME/miniconda3/bin/python"
  else
    PY="python3"
  fi
fi

if ! "$PY" -c "import market_platform" >/dev/null 2>&1; then
  echo "未找到 market_platform 包。请先安装: pip install -e '$ROOT'" >&2
  exit 1
fi

exec "$PY" -m market_platform.cli "$@"
